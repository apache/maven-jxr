<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xml:lang="en" lang="en">
    <!-- this is a JXR report set (jdk13) -->
    <head>
        <meta http-equiv="content-type" content="text/html; charset=$outputEncoding" />
        <title>$windowTitle</title>
        <link rel="stylesheet" type="text/css" href="stylesheet.css" title="style" />
        <script type="text/javascript" src="search.js"></script>
    </head>
    <body>
        ## Navigation Bar -------- START --------
        <div class="topNav">
            <ul class="navList" title="Navigation">
                <li class="navBarCell1Rev">Overview</li>
                <li>Package</li>
                <li>Class</li>
            </ul>
            <div class="aboutLanguage"><em><strong>$docTitle</strong></em></div>
        </div>
        <div class="subNav">
            <ul class="navList">
                <li><a href="allclasses-index.html">All Classes</a></li>
            </ul>
            ## the search script puts its box in here
            <span id="jxr_search"></span>
        </div>
        ## Navigation Bar -------- END --------

        ## Overview Summary -------- START --------
        <div class="header">
            <h1 class="title">$docTitle</h1>
        </div>
        <div class="contentContainer">
            <table class="overviewSummary" border="0" cellpadding="3" cellspacing="0" summary="Packages table, listing packages">
                <caption><span>Packages</span><span class="tabEnd">&nbsp;</span></caption>
                <thead>
                    <tr>
                        <th class="colFirst colLast" scope="col">Package</th>
                    </tr>
                </thead>
                <tbody>
                    #set ($rowclass = "rowColor")
                    #foreach ($pkgInfo in $info.allPackages.values())
                        #if ($rowclass == "rowColor")
                            #set ($rowclass = "altColor")
                        #else
                            #set ($rowclass = "rowColor")
                        #end
                    <tr class="${rowclass}">
                        <td class="colFirst colLast">
                            <a href="${pkgInfo.dir}/package-summary.html">$pkgInfo.name</a>
                        </td>
                    </tr>
                    #end
                </tbody>
            </table>
        </div>
        ## Overview Summary -------- END --------

        <div id="footer">
            ${bottom}
        </div>
    </body>
</html>
